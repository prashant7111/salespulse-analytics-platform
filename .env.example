# Required for hosted deployments; generate a long random value.
SALESPULSE_SECRET_KEY=replace-with-a-long-random-secret

# Optional security / runtime settings
SALESPULSE_COOKIE_SECURE=1
SALESPULSE_PERSIST_LOCAL_SECRET=0
SALESPULSE_MAX_UPLOAD_BYTES=52428800
# Optional. If set, webhook requests must include X-SalesPulse-Token.
SALESPULSE_WEBHOOK_TOKEN=replace-with-a-random-webhook-token

# Local launcher only
SALESPULSE_AUTO_OPEN=1
SALESPULSE_HOST=127.0.0.1
PORT=5050
